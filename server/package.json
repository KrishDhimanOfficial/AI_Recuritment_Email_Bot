{
  "name": "server",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "server": "cross-env NODE_ENV=dev nodemon ./bin/www",
    "client": "cd ../ && cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "concurrently \"npm run server:start\" \"npm run client:start\""
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "compression": "^1.8.1",
    "concurrently": "^10.0.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "csrf": "^3.1.0",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "mailparser": "^3.9.11",
    "morgan": "^1.10.1",
    "mysql2": "^3.22.5",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdf-parse-new": "^2.1.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
